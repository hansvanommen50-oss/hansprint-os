{
  "name": "@hansprint/hds",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./app-shell": {
      "import": "./dist/AppShell.js",
      "types": "./dist/AppShell.d.ts"
    }
  },
  "bin": {
    "hds": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@hansprint/theme": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}